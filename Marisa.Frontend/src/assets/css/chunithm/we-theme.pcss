.chu-song.chu-we {
    --we-band: #c702b3 9.34%, #ff04a6 0 12.07%, #03f0ee 0 21.18%, #0380f8 0 24.15%, #a6e85a 0 33.26%, #0cf469 0 36.22%, #fcf703 0 48.29%,
        #d504d9 0 60.36%, #02f7f8 0 69.02%, #06abf9 0 72.44%, #bce14f 0 84.51%, #fff202 0 96.58%, #f70c52 0;
    --we-spectrum: linear-gradient(90deg, #df00b5 0%, #13dcea 19%, #0dc35a 37%, #e9ed09 55%, #ff5826 72%, #e30986 86%, #4824c4 100%);
    --we-surface: linear-gradient(110deg, #242834 0%, #171b24 66%, #1e2230 100%);
}

.chu-song .chart-row.we-chart::before {
    background: linear-gradient(180deg, #df00b5, #13dcea 23%, #0dc35a 43%, #e9ed09 63%, #ff5826 80%, #4824c4);
    box-shadow: 0 0 10px #8f6bff40;
}
.chu-song .we-badge {
    border-color: transparent;
    background: linear-gradient(135deg, #252937, #12151d 72%) padding-box, var(--we-spectrum) border-box;
    color: #fff;
    font: 700 36px/1 'Microsoft YaHei', sans-serif;
    text-shadow: 0 0 10px #c9b8ff8c;
    box-shadow: 0 0 18px #8f6bff38, inset 0 0 12px #ffffff12;
}

.chu-song.chu-we-only {
    --pill-bg: linear-gradient(135deg, #2c303d, #1b1f29 72%);
    --pill-shadow: 0 2px 10px #05070d38;
    --chip-ink: #e5e8f2;
    --chip-bg: linear-gradient(135deg, #353948, #272b38 76%);
    --chip-ring: 0 0 0 1px #c5cbdf3b;
}
.chu-song.chu-we-only :deep(.stripe-layer + .absolute) { opacity: .36; }
.chu-song.chu-we-only :deep(.cover-frame) {
    --we-side-l: linear-gradient(94.5deg, #c303b3 14%, #04dfe8 0 28.26%, #43ef5f 0 42.66%, #f2e517 0 56.93%, #6a1e9a 0 71.2%, #1280b1 0 85.6%, #57bf4f 0);
    --we-side-r: linear-gradient(94.5deg, #fc02a5 13.27%, #06e4e9 0 26.8%, #a9e956 0 40.46%, #ffdb12 0 53.99%, #ee1a7a 0 67.53%, #21869d 0 81.19%, #5fae22 0 94.59%, #ff430e 0);
    background-image: linear-gradient(163.5deg, var(--we-band)), linear-gradient(163.5deg, var(--we-band)), var(--we-side-l), var(--we-side-r), var(--we-side-l), var(--we-side-r);
    background-position: left top, left bottom, left top, left top, right 2.08px top, right top;
    background-size: 292px 5px, 292px 5px, 2.92px 100%, 5px 100%, 2.92px 100%, 5px 100%;
    background-repeat: repeat-x, repeat-x, no-repeat, no-repeat, no-repeat, no-repeat;
    box-shadow: inset 0 0 0 2px #151922, 0 0 0 1px #bfc7d826, 0 8px 20px -12px #0009;
}
.chu-song.chu-we-only .section-tag {
    position: relative;
    overflow: hidden;
    background: var(--we-surface);
    box-shadow: 0 0 0 1px #c5cbdf28;
}
.chu-song.chu-we-only .section-tag::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(122deg, var(--we-band)) center / 260px 24px;
}
