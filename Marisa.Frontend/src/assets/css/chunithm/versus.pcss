.chu-versus .achievement { font-variant-numeric:tabular-nums; font-size:36px; letter-spacing:0; }
.chu-versus .score-main { padding-right:76px; }
.chu-versus .metrics { grid-template-columns:1fr; }
.chu-versus .metrics b { font-size:22px; }
.chu-versus .marks { --chu-mark-width:calc((100% - 16px) / 3); height:auto; margin-top:10px; }
.chu-versus .marks:empty { display:none; }
.chu-versus .difficulty { font-size:23px; }
.chu-batch .achievement { font-size:24px; }
.chu-batch .score-badges { height:20px; flex:0 0 20px; }
.chu-batch .scope-chip,.chu-multi-batch .scope-chip { border-color:color-mix(in srgb,var(--accent) 45%,transparent); background:color-mix(in srgb,var(--accent) 15%,transparent); color:#f0edf5; }

.chu-ultima .mai-accent-rail::before {
    background:var(--chu-ultima-ink);
    box-shadow:0 0 8px color-mix(in srgb,var(--chu-ultima-ink) 20%,transparent);
}
.chu-ultima .player,.chu-ultima .racer { --rail-opacity:.4; }
.chu-ultima .player.winner,.chu-ultima .racer.leader { --rail-opacity:1; }
.chu-ultima .racer.unplayed { --rail-opacity:.2; }
