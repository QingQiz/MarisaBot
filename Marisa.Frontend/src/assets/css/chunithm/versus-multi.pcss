.section-tag { font:700 21px 'Microsoft YaHei',sans-serif; letter-spacing:.08em; border-radius:4px; padding:5px 14px; background:var(--accent); color:#fff; box-shadow:0 0 0 1px #ffffff80; white-space:nowrap; }
.difficulty { font:900 23px 'SEGA NewRodin',sans-serif; letter-spacing:.03em; white-space:nowrap; }
.difficulty small { margin-left:10px; font:700 17px 'Torus',sans-serif; color:#ffffffb3; }
.round-badge { display:flex; align-items:baseline; gap:6px; font:700 12px 'Torus',sans-serif; letter-spacing:.24em; color:#ffffff8c; }
.round-badge b { font-size:26px; letter-spacing:.04em; color:#fff; }
.next-hint { font:700 13px 'Microsoft YaHei',sans-serif; color:#ffffff8c; }

/* 分数、等级、Rating 各有独立列；状态栏原生标竖排。 */
.racer-table {
    --racer-columns:48px minmax(0,1fr) 140px 64px 76px 128px;
    --racer-column-gap:24px;
    --racer-stamp-inset:16px;
    --racer-rank-width:64px;
    --chu-mark-width:128px;
}
.racer-columns {
    display:grid;
    grid-template-columns:var(--racer-columns);
    column-gap:var(--racer-column-gap);
    align-items:baseline;
    padding:0 19px 12px 23px;
    color:#ffffff66;
    font:700 10px/14px 'Torus',sans-serif;
    letter-spacing:.16em;
}
.column-place { justify-self:center; letter-spacing:.08em; }
.column-identity { display:flex; align-items:baseline; }
.column-score { justify-self:end; }
.column-rank { justify-self:center; }
.column-rating { justify-self:center; }
.column-status { grid-column:6; display:block; justify-self:start; font-size:9px; letter-spacing:.08em; }

.racers { display:flex; flex-direction:column; gap:8px; }
.racer {
    --rail-opacity:.85;
    --rail-top:12px;
    --rail-bottom:12px;
    min-width:0;
    padding:10px 18px 10px 22px;
    border:1px solid #ffffff1c;
    border-radius:4px;
    background:linear-gradient(105deg,#08081099,#08081047);
    overflow:hidden;
}
.racer.leader { border-color:#ffe6a34f; background:linear-gradient(105deg,#ffe5a80c,#08081059 52%); box-shadow:none; }
.racer.unplayed { --rail-opacity:.3; background:#08081047; }

.racer-main {
    display:grid;
    grid-template-columns:var(--racer-columns);
    grid-template-rows:90px;
    column-gap:var(--racer-column-gap);
    align-items:center;
    min-height:90px;
    min-width:0;
}
.racer-place { grid-column:1; grid-row:1; display:flex; align-items:baseline; justify-content:center; gap:2px; font-family:'Torus',sans-serif; }
.racer-place b { font-size:32px; font-weight:900; line-height:36px; }
.racer-place small { font-size:11px; font-weight:700; letter-spacing:.04em; }
.racer-identity { grid-column:2; grid-row:1; position:relative; display:flex; align-items:center; min-width:0; height:36px; }
.racer-identity.stamped { padding-right:calc(62px + var(--racer-stamp-inset)); }
.racer-name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:700 20px/36px 'Microsoft YaHei',sans-serif; }
.racer-stamp-slot { position:absolute; right:var(--racer-stamp-inset); top:50%; width:50px; height:50px; margin-top:-25px; --stamp-rotate:-12deg; }
.racer-stamp-slot .loser-stamp { font-size:32px; }

.score-line {
    grid-column:3;
    grid-row:1;
    position:relative;
    height:36px;
    min-width:0;
}
.score-line::before { content:''; position:absolute; left:calc(var(--racer-column-gap) / -2); top:2px; bottom:2px; width:1px; background:#ffffff12; }
.achievement { display:block; text-align:right; font:900 30px/36px 'Torus',sans-serif; font-variant-numeric:tabular-nums; white-space:nowrap; }
.leader .achievement { color:#ffe27a; }
.rank { grid-column:4; grid-row:1; width:var(--racer-rank-width); height:30px; object-fit:contain; display:block; justify-self:center; }
.gap { position:absolute; right:0; top:40px; font:700 11px/16px 'Torus',sans-serif; color:#ffffff61; font-variant-numeric:tabular-nums; white-space:nowrap; }
.rating-value { grid-column:5; grid-row:1; justify-self:stretch; text-align:center; font:900 30px/36px 'Torus',sans-serif; font-variant-numeric:tabular-nums; white-space:nowrap; }
.racer-empty { grid-column:3 / 6; grid-row:1; justify-self:center; font:700 16px 'SEGA NewRodin',sans-serif; letter-spacing:.08em; color:#ffffff4d; }

/* 每个标 128 × 26/134，最多三个标 + 两段 6px 间距，居中放入 90px 行。 */
.completion-row { grid-column:6; grid-row:1; position:relative; display:flex; align-items:center; justify-content:center; min-width:0; }
.completion-row :deep(.chu-marks) { width:128px; flex-direction:column; align-items:flex-start; justify-content:center; gap:6px; }
.completion-row::before { content:''; position:absolute; left:calc(var(--racer-column-gap) / -2); top:50%; width:1px; height:90px; transform:translateY(-50%); background:#ffffff12; }
