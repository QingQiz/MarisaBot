.mai-summary {
    position: relative;
    width: 1296px;
    overflow: hidden;
}

.mai-summary img {
    max-width: none;
}

.dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 255, 255, .07) 1.2px, transparent 1.6px) 0 0 / 22px 22px;
}

.eyebrow {
    font: 700 12px 'Torus', sans-serif;
    letter-spacing: .32em;
    color: rgba(255, 255, 255, .55);
}

.heading.han :deep(.mai-title) {
    font-family: 'Resource Han Rounded', 'Microsoft YaHei', sans-serif;
    font-weight: 900;
}

.heading :deep(.artist-line) {
    font-family: 'Torus', 'Microsoft YaHei', sans-serif;
    letter-spacing: .06em;
    color: rgba(255, 255, 255, .62);
}

.cond-chip {
    display: inline-block;
    padding: 3px 12px 4px;
    border-radius: 9999px;
    font: 700 14px 'Torus', 'Microsoft YaHei', sans-serif;
    letter-spacing: .04em;
    color: rgba(255, 255, 255, .85);
    background: rgba(255, 255, 255, .08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .18);
}

.big-count {
    text-align: right;
    font-family: 'Torus', sans-serif;
    line-height: 1;
}

.big-count b {
    font-size: 68px;
    font-weight: 800;
}

.big-count span {
    margin-left: 4px;
    font-size: 30px;
    font-weight: 700;
    color: rgba(255, 255, 255, .55);
}

.big-count small {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .22em;
    color: rgba(255, 255, 255, .55);
}

/* 姓名框 + 各难度剩余表：行高只由姓名框决定，表格上下沿与姓名框外框对齐 */
.plate-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 20px;
}

.nameplate {
    display: block;
    width: 560px;
    height: auto;
}

.plate-table {
    contain: size;
    display: grid;
    gap: 0 2px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .09);
}

.plate-col {
    display: flex;
    flex-direction: column;
    background: rgba(0, 0, 0, .42);
}

.plate-th {
    padding: 6px 0;
    text-align: center;
    font: 900 13px 'SEGA NewRodin', sans-serif;
    letter-spacing: .04em;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, .18);
    white-space: nowrap;
}

.plate-th.light {
    color: #4a1d78;
    text-shadow: none;
}

.plate-td {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-family: 'Torus', sans-serif;
    line-height: 1;
}

.remain {
    display: flex;
    align-items: baseline;
    gap: 4px;
}

.remain b {
    font-size: 32px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
}

.remain span {
    font: 700 11px 'Microsoft YaHei', sans-serif;
    color: rgba(255, 255, 255, .5);
}

.remain.clear {
    padding: 4px 0;
    font: 900 18px 'SEGA NewRodin', sans-serif;
    letter-spacing: .08em;
}

.frac {
    font-size: 13px;
    font-weight: 700;
    color: rgba(255, 255, 255, .55);
    font-variant-numeric: tabular-nums;
}

.seg-bar {
    display: flex;
    gap: 2px;
    height: 30px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(0, 0, 0, .25);
}

.seg {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font: 700 13px 'Torus', sans-serif;
    letter-spacing: .04em;
    color: rgba(20, 12, 30, .75);
}

.seg b {
    margin-left: 2px;
    font-weight: 800;
    color: #14081f;
}

.seg.np {
    color: rgba(255, 255, 255, .7);
}

.seg.np b {
    color: #fff;
}

.group-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
}

.g-capsule {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-right: 18px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, .06);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .18);
}

.g-capsule.complete {
    box-shadow: inset 0 0 0 1.5px var(--done), 0 0 16px -4px var(--done);
}

/* NewRodin 字形在行框内偏下偏右，按实测墨迹把内边距上移 2.5px、左移 2px */
.g-tag {
    min-width: 136px;
    padding: 3.5px 20px 9.5px 16px;
    border-radius: 9999px;
    text-align: center;
    font-family: 'SEGA NewRodin', sans-serif;
    font-weight: 900;
    font-size: 30px;
    line-height: 1;
    background: rgba(255, 255, 255, .1);
}

.g-capsule.complete .g-tag {
    background: var(--done);
    color: #14081f;
}

.g-count {
    min-width: 64px;
    text-align: right;
    white-space: nowrap;
    font: 700 17px 'Torus', sans-serif;
    color: rgba(255, 255, 255, .5);
    font-variant-numeric: tabular-nums;
}

.g-count b {
    font-size: 21px;
    color: #fff;
}

.g-min {
    flex: 0 0 84px;
    min-width: 0;
    display: flex;
    justify-content: center;
}

.g-min img {
    height: 28px;
    width: auto;
}

.mini {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
    width: 280px;
}

.mini-row {
    display: flex;
    gap: 1px;
    height: 10px;
    border-radius: 3px;
    overflow: hidden;
}

.mini-row i {
    flex-basis: 0;
}

.cells {
    display: grid;
    grid-template-columns: repeat(8, 128px);
    gap: 22px 24px;
}

/* 已达成 = 原色曲绘 + 白框 + 贴章；未达成 = 压暗空位；胶带 = 难度色 */
.slot {
    position: relative;
    width: 128px;
    height: 128px;
}

.photo {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 4px;
    border-radius: 12px;
    background: rgba(255, 255, 255, .05);
    outline: 2px dashed rgba(255, 255, 255, .22);
    outline-offset: -2px;
}

.inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    overflow: hidden;
}

.cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(.5);
}

.slot.got .photo {
    background: rgba(255, 255, 255, .88);
    outline: none;
    box-shadow: 0 8px 18px -8px rgba(0, 0, 0, .7);
    transform: rotate(var(--tilt, 0deg));
}

.slot.got .cover {
    filter: none;
}

.slot.got:nth-child(3n+1) .photo {
    --tilt: -1.2deg;
}

.slot.got:nth-child(3n+2) .photo {
    --tilt: .9deg;
}

.tape {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 46px;
    height: 13px;
    border-radius: 2px;
    opacity: .85;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
    transform: translateX(-50%) rotate(-4deg);
}

.sticker {
    position: absolute;
    right: -10px;
    bottom: -8px;
    height: 54px;
    width: auto;
    transform: rotate(-10deg);
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff) drop-shadow(0 3px 5px rgba(0, 0, 0, .55));
}

.sticker.rank {
    right: -12px;
    bottom: -6px;
    height: 32px;
}

.sticker.dxstar {
    width: 56px;
    height: 56px;
    object-fit: contain;
}

.ach-pill {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    display: flex;
    align-items: baseline;
    padding: 4px 11px;
    border-radius: 9999px;
    white-space: nowrap;
    background: rgba(8, 4, 16, .85);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .22);
    font-family: 'Torus', sans-serif;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
}

.ach-pill b {
    font-size: 24px;
}

.ach-pill small {
    font-size: 15px;
    font-weight: 700;
    opacity: .8;
}

.progress-icon {
    position: absolute;
    left: 50%;
    bottom: 4px;
    height: 34px;
    width: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .7));
}

/* sum 格子沿用改版前的评级与成绩条尺寸、字体、字号 */
.sum-rank {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 44px;
    width: auto;
    transform: translate(-50%, -65%);
    pointer-events: none;
}

.achievement-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 42px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 5px;
    background: rgba(0, 0, 0, 0.85);
    font-weight: bold;
    font-family: 'Consolas', 'Segoe UI', 'Arial Unicode MS Font', monospace;
    line-height: 1;
}

.ach-int {
    font-size: 32px;
}

.ach-frac {
    font-size: 23px;
}
